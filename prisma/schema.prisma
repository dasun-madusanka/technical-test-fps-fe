generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  level  Int @default(1)
  xp     Int @default(0)
  wins   Int @default(0)
  losses Int @default(0)
  kills  Int @default(0)
  deaths Int @default(0)
  rating Int @default(1000)

  weaponStats PlayerWeaponStat[]

  settings UserSettings?
}

model Weapon {
  id       String  @id @default(cuid())
  key      String  @unique // e.g. "rifle", "sniper", "pistol", "knife"
  name     String
  category String  // "primary", "secondary", "melee"
  damage   Int
  fireRate Int
  magazineSize Int

  variants WeaponVariant[]
  stats    PlayerWeaponStat[]
}

model WeaponVariant {
  id            String @id @default(cuid())
  weaponId      String
  weapon        Weapon @relation(fields: [weaponId], references: [id])
  name          String
  unlockType    String // "kills" or "headshots"
  unlockAmount  Int
  sortOrder     Int    @default(0)
}

model PlayerWeaponStat {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  weaponId  String
  weapon    Weapon @relation(fields: [weaponId], references: [id])
  kills     Int    @default(0)
  headshots Int    @default(0)
  selected  Boolean @default(false)
  selectedVariantId String?

  @@unique([userId, weaponId])
}

model UserSettings {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id])
  mouseSens      Float  @default(0.7)
  aimSens        Float  @default(0.65)
  keyForward     String @default("KeyW")
  keyBackward    String @default("KeyS")
  keyLeft        String @default("KeyA")
  keyRight       String @default("KeyD")
  keyJump        String @default("Space")
  keyReload      String @default("KeyR")
}