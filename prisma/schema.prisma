generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  level  Int @default(1)
  xp     Int @default(0)
  wins   Int @default(0)
  losses Int @default(0)
  kills  Int @default(0)
  deaths Int @default(0)
  rating Int @default(1000)
}